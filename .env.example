# Configuration des variables d'environnement
# Copiez ce fichier vers .env et remplissez les valeurs

# Google Cloud Vision API
# Chemin vers le fichier JSON de credentials du compte de service Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=credentials/google_credentials.json

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Configuration optionnelle
# DPI pour la conversion PDF (défaut: 300)
# DPI_DEFAULT=300

# Activer/désactiver le cache (défaut: true)
# CACHE_ENABLED=true
